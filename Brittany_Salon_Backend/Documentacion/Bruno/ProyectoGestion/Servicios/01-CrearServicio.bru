meta {
  name: Crear Servicio
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/services
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  serviceName: Corte de Cabello
  serviceDescription: Corte profesional
  price: 15000
  durationMinutes: 45
  serviceType: Cabello
  isActive: true
  image: @file(./imagen.jpg)
}

